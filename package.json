{
  "name": "@miorin/dsh-atlas-list",
  "version": "0.1.0",
  "private": false,
  "license": "MIT",
  "type": "module",
  "description": "Switch sidebar list views, mark drafts, keep watched sessions visible, see active jobs, and check collapsed sidebar session counts.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/miorin-chan/dsh-atlas-list.git"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-bundle",
    "sidebar-list",
    "aggregate"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "aggregate.yml",
    "client.js",
    "index.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.zh.md",
    "AGENTS.md",
    "AGENTS.local.md",
    "docs/README.md",
    "docs/DETAIL.*.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "dsh": ">=0.2.2-rc.5",
    "node": "^22.18.0 || >=24.11.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build:tools": "tsc -p tsconfig.tools.json",
    "build": "dsh-aggregate generate . && npm run build:tools && node scripts/build.mjs",
    "prepare": "npm run build 1>&2",
    "typecheck": "tsc -p tsconfig.json",
    "test:unit": "node --test",
    "test": "npm run build && npm run check",
    "check": "dsh-aggregate check . && npm run build:tools && npm run test:unit && npm run typecheck && node scripts/build.mjs --check && node scripts/sync-types.mjs --check",
    "prepublishOnly": "dsh-aggregate verify-release . && npm run build"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.1.0",
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.2-rc.5",
    "@miorin/dsh-aggregate": "link:../../packages/dsh-aggregate",
    "@types/node": "22.20.5",
    "esbuild": "0.28.2",
    "typescript": "5.7.3"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "aggregate": {
      "version": 1,
      "runtimeRowId": "dsh-atlas-list",
      "plugins": [
        "@miorin/dsh-session-list-toggle",
        "@miorin/dsh-session-draft",
        "@miorin/dsh-watched-sessions",
        "@miorin/dsh-background-jobs-sidebar",
        "@miorin/dsh-collapsed-sidebar-status"
      ],
      "defaults": {
        "@miorin/dsh-session-list-toggle": true,
        "@miorin/dsh-session-draft": true,
        "@miorin/dsh-watched-sessions": true,
        "@miorin/dsh-background-jobs-sidebar": true,
        "@miorin/dsh-collapsed-sidebar-status": true
      }
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  },
  "dependencies": {
    "@miorin/dsh-session-draft": "0.1.1",
    "@miorin/dsh-watched-sessions": "0.1.3",
    "@miorin/dsh-background-jobs-sidebar": "0.1.1",
    "@miorin/dsh-session-list-toggle": "0.1.0",
    "@miorin/dsh-collapsed-sidebar-status": "0.1.0"
  },
  "homepage": "https://github.com/miorin-chan/dsh-atlas-list#readme",
  "bugs": {
    "url": "https://github.com/miorin-chan/dsh-atlas-list/issues"
  }
}
