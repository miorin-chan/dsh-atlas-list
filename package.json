{
  "name": "@miorin/dsh-atlas-list",
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "description": "Switch sidebar list views, mark drafts, keep watched sessions visible, see active jobs, and check collapsed sidebar session counts.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/miorin-chan/dsh-atlas-list.git"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-bundle",
    "sidebar-list",
    "aggregate"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "aggregate.yml",
    "client.js",
    "index.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.zh.md",
    "AGENTS.md",
    "AGENTS.local.md",
    "docs/README.md",
    "docs/DETAIL.*.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "dsh": "0.2.2-rc.5"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "node ../../tools/dsh-aggregate/src/cli.mts generate .",
    "prepare": "node --input-type=module -e \"import { existsSync } from 'node:fs'; import { execFileSync } from 'node:child_process'; const cli = '../../tools/dsh-aggregate/src/cli.mts'; if (existsSync(cli)) execFileSync(process.execPath, [cli, 'generate', '.'], { stdio: 'inherit' })\" 1>&2",
    "test": "npm run build && npm run check",
    "check": "node ../../tools/dsh-aggregate/src/cli.mts check .",
    "prepublishOnly": "node ../../tools/dsh-aggregate/src/cli.mts verify-release ."
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "aggregate": {
      "version": 1,
      "runtimeRowId": "dsh-atlas-list",
      "plugins": [
        "@miorin/dsh-session-list-toggle",
        "@miorin/dsh-session-draft",
        "@miorin/dsh-watched-sessions",
        "@miorin/dsh-background-jobs-sidebar",
        "@miorin/dsh-collapsed-sidebar-status"
      ],
      "defaults": {
        "@miorin/dsh-session-list-toggle": true,
        "@miorin/dsh-session-draft": true,
        "@miorin/dsh-watched-sessions": true,
        "@miorin/dsh-background-jobs-sidebar": true,
        "@miorin/dsh-collapsed-sidebar-status": true
      }
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  },
  "dependencies": {
    "@miorin/dsh-session-draft": "0.1.0",
    "@miorin/dsh-watched-sessions": "link:../dsh-watched-sessions",
    "@miorin/dsh-background-jobs-sidebar": "link:../dsh-background-jobs-sidebar",
    "@miorin/dsh-session-list-toggle": "link:../dsh-session-list-toggle",
    "@miorin/dsh-collapsed-sidebar-status": "link:../dsh-collapsed-sidebar-status"
  }
}
